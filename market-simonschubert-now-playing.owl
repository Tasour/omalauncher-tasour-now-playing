widget "now-playing" {
  size: 6x2
  padding: 8
  minSize: 3x2
  requires { pacman: [] }
  meta { description: "What's playing on your phone, from any music or podcast app: album art, track, progress and play, pause and skip. Tap the tile to open the app"; version: "1.5"; license: "MIT"; category: "fun"; owl: 16 }

  strings {
    en {
      nowPlaying: "now playing"
      allow: "Allow notification access so the launcher can see what's playing. Tap to open the setting."
      nothing: "nothing playing"
      start: "start music in any app"
      lastTrack: "last played · tap to open"
    }
    fr {
      nowPlaying: "lecture en cours"
      allow: "Autorise l'accès aux notifications pour qu'omalauncher voie ce qui joue. Toucher pour ouvrir le réglage."
      nothing: "rien en lecture"
      start: "lance de la musique dans une app"
      lastTrack: "dernier titre · toucher pour ouvrir"
    }
  }

  // {available, playing, title, artist, album, app, package, position, duration, art}.
  // Android only shares other apps' sessions with notification access; without it, available is false.
  source m = android.media

  state last = null persist

  let has = m != null && m.title != null
  let mediaKey = has ? {title: m.title, artist: m.artist, album: m.album, app: m.app, package: m.package, art: m.art, duration: m.duration} : null
  on mediaKey first {
    if value != null {
      last = {title: value.title, artist: value.artist, album: value.album, app: value.app, package: value.package, art: value.art ?? (last != null && value.title == last.title && value.artist == last.artist && value.album == last.album ? last.art : null), duration: value.duration}
    }
  }

  let saved = last == null ? false : last.title != null
  let info = has ? m : last
  // Keep the last image shown. With the launcher patch, last.art is a guest
  // file path; without it, Image simply fails and the placeholder stays.
  let shownArt = has && m.art != null ? m.art : (last == null ? null : last.art)
  let playingNow = has ? m.playing == true : false
  let allowed = m == null || m.available != false
  let dur = has ? num(m.duration, 0) : 0
  let pos = dur > 0 ? clamp(num(m.position, 0), 0, dur) : 0
  let narrow = cols != null && cols < 5
  let art = clamp(min((tileHeight ?? 130) - 26, (tileWidth ?? 400) * 0.29), 40, 112)
  // A tile taller than wide (landscape home screen, or a tall portrait tile) stacks
  // art, text and controls vertically instead of side by side.
  let tall = tileWidth != null && tileHeight != null && tileHeight > tileWidth * 1.3
  // Two rows leave no room for wrapped text beside the art; keep one line there.
  let tight = tileHeight != null && tileHeight < 150
  let playSize = tight ? 44 : 60
  // In a tall tile the square art takes the tile's usable width, however big the tile is.
  let tallArt = tall ? max(tileWidth - 26, 40) : 0

  onTap: {
    if allowed {
      if !has && saved && last.package != null { androidApp(last.package) } else { media("open") }
    } else {
      media("open")
    }
  }

  component Clock(s) {
    Text { text: s == null ? "" : "${floor(s / 60)}:${pad(floor(s % 60), 2, "0")}"; style: label; color: muted; font: mono; maxLines: 1; width: len("${floor(s / 60)}") * 7 + 22 }
  }

  // Drawn, not glyphs: the launcher's icon font only carries weather symbols. Paths need an
  // explicit fill: to be filled. Play/pause is a solid disc with the glyph in the background color.
  component Control(kind, big = false) {
    Box {
      size: big ? playSize : 32
      onTap: media(kind)
      Canvas {
        let cx = width / 2
        let cy = height / 2
        let d = min(width, height)
        if kind == "toggle" {
          circle(cx, cy, d / 2, fill: foreground)
          if m.playing == true {
            rect(cx - d * 0.15, cy - d * 0.18, d * 0.11, d * 0.36, radius: d * 0.03, fill: background)
            rect(cx + d * 0.04, cy - d * 0.18, d * 0.11, d * 0.36, radius: d * 0.03, fill: background)
          } else {
            // The triangle's centroid sits right of its box: nudge it so it looks centered.
            path([[cx - d * 0.12, cy - d * 0.2], [cx + d * 0.21, cy], [cx - d * 0.12, cy + d * 0.2]], closed: true, fill: background)
          }
        } else {
          let dir = kind == "next" ? 1 : -1
          path([[cx - d * 0.19 * dir, cy - d * 0.2], [cx + d * 0.1 * dir, cy], [cx - d * 0.19 * dir, cy + d * 0.2]], closed: true, fill: foreground)
          rect(dir > 0 ? cx + d * 0.1 : cx - d * 0.18, cy - d * 0.2, d * 0.08, d * 0.4, radius: d * 0.03, fill: foreground)
        }
      }
    }
  }

  // A small equalizer that only exists (and only animates) while something plays.
  component Bars() {
    Canvas {
      width: 14
      height: 12
      for i in range(3) {
        let h = 3 + (sin(time * (5 + i * 1.7) + i * 2) * 0.5 + 0.5) * (height - 3)
        rect(i * 5, height - h, 3, h, radius: 1, color: accent)
      }
    }
  }

  component Art(src, d) {
    Box {
      size: d
      // Rounded as much as the launcher's corner style: square on edge, 8dp on round.
      radius: 8 * corners
      clip: true
      align: center
      // Gradients only fill inside a Canvas, not as a background.
      Canvas {
        rect(0, 0, width, height, fill: linear(0, 0, width, height, [alpha(accent, 0.55), alpha(magenta, 0.35)]))
        text("♪", width / 2, height / 2, size: d * 0.45, align: center, color: alpha(foreground, 0.85))
      }
      if src != null {
        Image { src: src; fit: cover; fill: true }
      }
    }
  }

  // The source app, with a live equalizer while it plays.
  component AppLine() {
    Row {
      align: center
      gap: 6
      if playingNow {
        Bars { }
      }
      Text { text: lower(info.app ?? ""); style: label; color: playingNow ? accent : muted; maxLines: 1; weight: 1 }
    }
  }

  if !allowed {
    Column {
      justify: center
      gap: 6
      Text { text: str.nowPlaying; style: muted }
      Text { text: str.allow; style: small; maxLines: 3 }
    }
  } else {
    if !has && !saved {
      if tall {
        Column {
          gap: 10
          Art { src: null; d: tallArt }
          Text { text: str.nothing; style: body; color: muted }
          Text { text: str.start; style: small; color: muted; maxLines: 2 }
        }
      } else {
        Row {
          align: center
          gap: 12
          Art { src: null; d: art }
          Column {
            weight: 1
            gap: 2
            Text { text: str.nothing; style: body; color: muted }
            Text { text: str.start; style: small; color: muted; maxLines: 1 }
          }
        }
      }
    } else {
      if tall {
        Column {
          gap: 8
          Art { src: shownArt; d: tallArt }
          Column {
            gap: 2
            AppLine { }
            Text { text: info.title; style: body; bold: true; maxLines: 3 }
            Text { text: info.artist ?? ""; style: small; color: muted; maxLines: 2 }
            Text { text: info.album ?? ""; style: small; color: muted; maxLines: 2 }
            if !has { Text { text: str.lastTrack; style: label; color: muted; maxLines: 1 } }
          }
          Spacer { weight: 1 }
          if has {
            if dur > 0 {
              Progress { value: pos; max: dur; color: accent; track: alpha(muted, 0.2); animate value: tween(900ms, "linear") }
              Row {
                align: center
                gap: 4
                Clock { s: pos }
                Spacer { weight: 1 }
                Clock { s: dur }
              }
            }
            Row {
              align: center
              gap: 4
              Spacer { weight: 1 }
              Control { kind: "previous" }
              Control { kind: "toggle"; big: true }
              Control { kind: "next" }
              Spacer { weight: 1 }
            }
          }
        }
      } else {
        Row {
          align: center
          gap: 12
          if !narrow {
            Art { src: shownArt; d: art }
          }
          Column {
            weight: 1
            gap: 2
            Text { text: info.title; style: body; bold: true; maxLines: tight ? 1 : 3 }
            Text {
              spans: [info.artist ?? "", {text: narrow || info.album == null ? "" : (info.artist == null ? info.album : " · ${info.album}"), color: info.artist == null ? foreground : muted}]
              style: small
              color: foreground
              maxLines: tight ? 1 : 2
            }
            if !has { Text { text: str.lastTrack; style: label; color: muted; maxLines: 1 } }
            Spacer { weight: 1 }
            if has {
              if dur > 0 {
                Progress { value: pos; max: dur; color: accent; track: alpha(muted, 0.2); animate value: tween(900ms, "linear") }
              }
              Row {
                align: center
                gap: 6
                if dur > 0 {
                  Clock { s: pos }
                  Text { text: "/"; style: label; color: alpha(muted, 0.5); width: 8 }
                  Clock { s: dur }
                }
                Spacer { weight: 1 }
                Control { kind: "previous" }
                Control { kind: "next" }
                Control { kind: "toggle"; big: true }
              }
            }
          }
        }
      }
    }
  }
}
